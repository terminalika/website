---
/**
 * <ThemeToggle> — replaces Starlight's ThemeSelect.
 *
 * A single button that cycles system -> light -> dark -> system, rendered
 * as `[system]` / `[light]` / `[dark]`. It reads and writes the same
 * localStorage key and encoding Starlight's own theme script uses
 * (`starlight-theme`; '' means "system"), so:
 *  - Starlight's built-in inline script (ThemeProvider.astro, still active -
 *    only ThemeSelect is swapped out) resolves the initial `data-theme`
 *    before paint, avoiding a flash;
 *  - the choice survives navigation and reloads.
 * While the mode is "system", a media query listener keeps `data-theme` (and
 * so the `--tk-*` tokens in terminal.css) in sync with OS changes live.
 */
---

<button
	class="tk-theme-toggle"
	type="button"
	data-theme-toggle
	aria-live="polite"
	title="Cycle theme: system / light / dark">system</button>

<script>
	const KEY = 'starlight-theme';
	type Mode = 'system' | 'light' | 'dark';

	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: light)');

	// Starlight stores '' for "system", 'light'/'dark' otherwise.
	function load(): Mode {
		let stored: string | null = null;
		try {
			stored = localStorage.getItem(KEY);
		} catch {
			/* storage may be unavailable */
		}
		return stored === 'light' || stored === 'dark' ? stored : 'system';
	}

	function store(mode: Mode) {
		try {
			localStorage.setItem(KEY, mode === 'system' ? '' : mode);
		} catch {
			/* the page still switches for this view */
		}
	}

	const resolve = (mode: Mode) => (mode === 'system' ? (media.matches ? 'light' : 'dark') : mode);

	const NEXT: Record<Mode, Mode> = { system: 'light', light: 'dark', dark: 'system' };

	let mode: Mode = load();

	function render() {
		root.dataset.theme = resolve(mode);
		for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			btn.textContent = mode;
			btn.setAttribute('aria-label', `Theme: ${mode}. Click for ${NEXT[mode]}`);
		}
	}

	function set(next: Mode) {
		mode = next;
		store(mode);
		render();
	}

	// Reflect the system preference live while in "system" mode.
	media.addEventListener('change', () => {
		if (mode === 'system') render();
	});

	render();

	for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		btn.addEventListener('click', () => set(NEXT[mode]));
	}
</script>
