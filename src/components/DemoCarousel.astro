---
/**
 * The home page's demo: the CLI capture first, the pi extension's behind
 * it - a Swiper carousel. Arrows fade in on hover (always visible on
 * touch), ←/→ work while it is in view, swiping works, and only the
 * visible video plays.
 */
const slides = [
	{
		src: '/demo.mp4',
		name: 'cli',
		label: 'in the pane next to Claude Code',
		aria: 'terminalika in the pane next to Claude Code: the game pauses the moment the agent needs you',
	},
	{
		src: '/demo-pi.mp4',
		name: 'pi plugin',
		label: '/play inside pi',
		aria: 'terminalika inside pi: /play opens a game over the conversation, and it pauses the moment pi is waiting for you',
	},
];
---

<div class="tk-carousel not-content">
	<div class="swiper tk-carousel-swiper" aria-label="terminalika demos">
		<div class="swiper-wrapper">
			{
				slides.map((s, i) => (
					<div class="swiper-slide" data-label={s.label} data-name={s.name}>
						<video
							class="tk-demo"
							src={s.src}
							autoplay={i === 0}
							loop
							muted
							playsinline
							preload={i === 0 ? 'auto' : 'metadata'}
							aria-label={s.aria}
						/>
					</div>
				))
			}
		</div>
		<div class="swiper-button-prev"></div>
		<div class="swiper-button-next"></div>
	</div>
	<div class="tk-carousel-caption">
		<span class="tk-carousel-label" aria-live="polite">{slides[0].label}</span>
		<div class="tk-carousel-dots swiper-pagination"></div>
	</div>
</div>

<script>
	import Swiper from 'swiper';
	import { A11y, Keyboard, Navigation, Pagination } from 'swiper/modules';
	import 'swiper/css';
	import 'swiper/css/navigation';
	import 'swiper/css/pagination';

	for (const root of document.querySelectorAll<HTMLElement>('.tk-carousel')) {
		const el = root.querySelector<HTMLElement>('.tk-carousel-swiper')!;
		const label = root.querySelector<HTMLElement>('.tk-carousel-label')!;
		const videos = [...el.querySelectorAll<HTMLVideoElement>('video')];
		const names = [...el.querySelectorAll<HTMLElement>('.swiper-slide')].map((s) => s.dataset.name ?? '');

		new Swiper(el, {
			modules: [Navigation, Keyboard, Pagination, A11y],
			slidesPerView: 1,
			speed: 350,
			navigation: {
				nextEl: el.querySelector<HTMLElement>('.swiper-button-next')!,
				prevEl: el.querySelector<HTMLElement>('.swiper-button-prev')!,
			},
			pagination: {
				el: root.querySelector<HTMLElement>('.tk-carousel-dots')!,
				clickable: true,
				renderBullet: (i, cls) => `<button type="button" class="${cls}">${names[i]}</button>`,
			},
			keyboard: { enabled: true, onlyInViewport: true },
			on: {
				slideChange(swiper) {
					const active = swiper.slides[swiper.activeIndex] as HTMLElement;
					label.textContent = active.dataset.label ?? '';
					videos.forEach((v, i) => {
						if (i === swiper.activeIndex) {
							v.currentTime = 0;
							v.play().catch(() => {});
						} else {
							v.pause();
						}
					});
				},
			},
		});
	}
</script>
