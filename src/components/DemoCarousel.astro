---
/**
 * The home page's demo: the CLI capture first, the pi extension's behind
 * it. Arrows fade in on hover (always visible on touch), ←/→ work while
 * the carousel has focus, and only the visible video plays. No library:
 * two slides don't need one.
 */
const slides = [
	{
		src: '/demo.mp4',
		label: 'CLI · in the pane next to Claude Code',
		aria: 'terminalika in the pane next to Claude Code: the game pauses the moment the agent needs you',
	},
	{
		src: '/demo-pi.mp4',
		label: 'pi extension · /play inside pi',
		aria: 'terminalika inside pi: /play opens a game over the conversation, and it pauses the moment pi is waiting for you',
	},
];
---

<div class="tk-carousel" tabindex="0" aria-roledescription="carousel" aria-label="terminalika demos">
	{
		slides.map((s, i) => (
			<video
				class="tk-demo tk-carousel-slide"
				src={s.src}
				autoplay={i === 0}
				loop
				muted
				playsinline
				preload={i === 0 ? 'auto' : 'metadata'}
				aria-label={s.aria}
				hidden={i !== 0}
			/>
		))
	}
	<button class="tk-carousel-arrow tk-carousel-prev" type="button" aria-label="previous demo" hidden>‹</button>
	<button class="tk-carousel-arrow tk-carousel-next" type="button" aria-label="next demo">›</button>
	<div class="tk-carousel-caption" aria-live="polite">
		<span class="tk-carousel-label">{slides[0].label}</span>
		<span class="tk-carousel-dots" aria-hidden="true">
			{slides.map((_, i) => <span class:list={['tk-carousel-dot', { on: i === 0 }]} />)}
		</span>
	</div>
</div>

<script define:vars={{ labels: slides.map((s) => s.label) }}>
	for (const root of document.querySelectorAll('.tk-carousel')) {
		const slides = [...root.querySelectorAll('.tk-carousel-slide')];
		const prev = root.querySelector('.tk-carousel-prev');
		const next = root.querySelector('.tk-carousel-next');
		const label = root.querySelector('.tk-carousel-label');
		const dots = [...root.querySelectorAll('.tk-carousel-dot')];
		let index = 0;

		const show = (to) => {
			if (to < 0 || to >= slides.length || to === index) return;
			slides[index].pause();
			slides[index].hidden = true;
			index = to;
			const v = slides[index];
			v.hidden = false;
			v.currentTime = 0;
			v.play().catch(() => {});
			prev.hidden = index === 0;
			next.hidden = index === slides.length - 1;
			label.textContent = labels[index];
			dots.forEach((d, i) => d.classList.toggle('on', i === index));
		};

		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));
		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') show(index + 1);
			else if (e.key === 'ArrowLeft') show(index - 1);
			else return;
			e.preventDefault();
		});
	}
</script>
